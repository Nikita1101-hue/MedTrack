# Copy this file to ".env" and edit the values. NEVER commit ".env".

# development -> uses a local JSON file (no AWS needed)
# production  -> uses Amazon DynamoDB through boto3
APP_MODE=development

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- AWS (production) ---
AWS_REGION=ap-south-1
# On EC2 attach an IAM ROLE to the instance and leave the keys below out.
# Only for running on your own laptop against real DynamoDB:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Set to "true" in development if you want to test against real DynamoDB
USE_DYNAMODB=false

# First administrator account (created automatically if no admin exists).
# In production both values are REQUIRED.
ADMIN_EMAIL=admin@medtrack.com
ADMIN_PASSWORD=Admin@123

# Set to "true" only when the site is served over HTTPS
SESSION_COOKIE_SECURE=false

PORT=5000
